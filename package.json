{
    "name": "@markstanden/opencode-docs-plugin",
    "version": "0.6.1",
    "type": "module",
    "description": "OpenCode V2 plugin: a `docs` tool and `/docs` command over configurable knowledge lakes (repo, machine, global and read-only wiki), nested README.md search, and the writing convention they share",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/markstanden/opencode-docs-plugin.git"
    },
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "src",
        "CONVENTION.md",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "node --test 'tests/**/*.test.ts'",
        "test:watch": "node --test --watch 'tests/**/*.test.ts'",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@opencode/plugin": "2.0.23",
        "@opencode/schema": "2.0.23",
        "effect": "4.0.0-rc.112"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "typescript": "^6.0.3"
    },
    "license": "MIT"
}
