{
    "name": "opencode-docs-plugin-evaluations",
    "private": true,
    "version": "0.0.0",
    "description": "Development-only evaluation tooling for the docs plugin; never shipped.",
    "type": "module",
    "devDependencies": {
        "@markstanden/opencode-test-container": "file:./vendor/markstanden-opencode-test-container-0.1.0.tgz"
    },
    "scripts": {
        "validate": "otc validate --campaign docs-placement/campaign.json",
        "prepare-run": "otc prepare --campaign docs-placement/campaign.json --root .otc-root",
        "freeze": "otc freeze --root .otc-root",
        "status": "otc status --root .otc-root --json",
        "test": "node --test 'tests/**/*.test.ts'"
    }
}
