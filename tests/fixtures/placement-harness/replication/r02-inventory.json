            "mentionPatterns": [
                "\\b(?:max(?:imum)?|pool|connections?)\\b[^\\n.]{0,60}\\b(?:10|ten)\\b",
                "\\b(?:10|ten)\\b[^\\n.]{0,60}\\b(?:connections?|pool)\\b"
            ]
        },
        {
            "id": "acquireTimeout",
            "label": "5-second acquire timeout",
            "mentionPatterns": [
                "\\b(?:acquire|acquiring|wait|waits|timeout|connection)\\b[^\\n.]{0,60}\\b(?:5|five)\\s*(?:(?:\\.0)\\s*)?(?:s\\b|sec(?:ond)?s?\\b|ms\\b|milliseconds?)\\b",
                "\\b(?:5|five)\\s*(?:(?:\\.0)\\s*)?(?:s\\b|sec(?:ond)?s?\\b|ms\\b|milliseconds?)\\b[^\\n.]{0,60}\\b(?:acquire|acquiring|wait|waits|timeout|connection)\\b",
                "\\b5000\\s*(?:ms|milliseconds?)\\b"
            ]
        },
        {
            "id": "startupMigrations",
            "label": "startup migrations",
