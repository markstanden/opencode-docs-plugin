# Trial sandbox for the placement harness: Debian slim, Node LTS, current CLI.
# Built and run by container-run.sh. The repository, fixtures, prompts and
# results are mounted at runtime — nothing local is copied into the image.
FROM docker.io/library/node:lts-slim

ARG HOST_UID=1000
ARG HOST_GID=1000

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --silent @opencode/cli@latest \
    && mkdir -p /workspace /tmp/agent-home \
    && chown -R "${HOST_UID}:${HOST_GID}" /workspace /tmp/agent-home

USER ${HOST_UID}:${HOST_GID}
WORKDIR /workspace
ENV HOME=/tmp/agent-home
